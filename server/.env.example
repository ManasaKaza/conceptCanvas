APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HISTORY_ENABLED=true
DB_PATH=conceptcanvas.db
REQUESTS_PER_MINUTE=20
MAX_REQUEST_BYTES=250000

USE_AI=true
AI_PROVIDER=groq
GROQ_API_KEY=replace-with-your-key
GROQ_MODEL=llama-3.1-8b-instant
AI_TIMEOUT_SECONDS=20
AI_RETRY_ATTEMPTS=1
AI_RETRY_DELAY_SECONDS=1
AI_REPAIR_ENABLED=true

# Optional Gemini provider
GEMINI_API_KEY=replace-with-your-key
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=25
GEMINI_RETRY_ATTEMPTS=2
GEMINI_RETRY_DELAY_SECONDS=1

# Claim-level source grounding
GROUNDING_PROVIDER=catalog
GROUNDING_CATALOG_PATH=grounding/source_catalog.json
GROUNDING_MAX_CLAIMS=18
# Use http or hybrid in production with a trusted retrieval-and-verification service.
# GROUNDING_API_URL=https://your-grounding-service.example/verify
# GROUNDING_API_KEY=replace-with-your-key
